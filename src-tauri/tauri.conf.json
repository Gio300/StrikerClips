{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KillCam",
  "version": "0.1.0",
  "identifier": "app.killcam.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "KillCam",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Multi-angle kill highlights, clans, live chat rooms, tournaments — for every game.",
    "longDescription": "KillCam combines every player's clip of the same moment into one synced multi-angle edit, publishes it to the KillCam YouTube channel, and gives clans pages, rosters, chat rooms, and leaderboards to battle over. Your stream keys, your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {}
}
