# ============================================================================
#  KillCam — environment configuration
#  https://killcam.app
# ============================================================================
#
# NOTE ON RUNTIME vs BUILD config:
#   Vite bakes VITE_* vars at BUILD time. For the Cloud Run deploy we ALSO
#   support RUNTIME injection (see public/runtime-config.js + docker-entrypoint.sh)
#   so the Supabase anon key and other public config can be set as Cloud Run env
#   vars WITHOUT rebuilding. The container maps these plain names ->
#   window.__KILLCAM_CONFIG__:  SUPABASE_URL, SUPABASE_ANON_KEY, APP_URL,
#   ADSENSE_CLIENT, ADROLL_ADV_ID, ADROLL_PIX_ID.
#   Locally, use the VITE_* names below in .env.local.

# --- Required for app to load (else the app shows a "configuration required"
#     screen instead of white-screening) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Deploy base path ---
# Default is '/' (canonical home = killcam.app served at the domain root on
# Cloud Run). Only set this to a sub-path for the legacy GitHub Pages preview
# (e.g. VITE_BASE_PATH=/StrikerClips/).
VITE_BASE_PATH=/

# Absolute URL of the deployed app (used in share links / OG).
VITE_APP_URL=https://killcam.app

# --- AdSense (optional, leave empty to disable) ---
# Get a client ID from https://www.google.com/adsense/
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_RANKINGS_HERO=
VITE_ADSENSE_RANKINGS_BETWEEN=
VITE_ADSENSE_STAT_CHECK_HERO=
VITE_ADSENSE_STAT_CHECK_BETWEEN=
VITE_ADSENSE_SCREENSHOTS_SUBMIT=
VITE_ADSENSE_REEL_PREROLL=
VITE_ADSENSE_REEL_TOP=
VITE_ADSENSE_REEL_BOTTOM=
VITE_ADSENSE_LANDING_MID=
VITE_ADSENSE_REELS_LIST_INLINE=
VITE_ADSENSE_FEED_INLINE=
# Creation gate: full-width ad before a free user can submit a new reel.
VITE_ADSENSE_CREATE_GATE=
# Future: before MP3/MP4 export without Pro.
VITE_ADSENSE_EXPORT_GATE=
# High-dwell inventory: clans, leaderboards, and chat rooms.
VITE_ADSENSE_CLANS_HERO=
VITE_ADSENSE_CLANS_LEADERBOARD_INLINE=
VITE_ADSENSE_CLAN_DETAIL_RAIL=
VITE_ADSENSE_ROOM_INLINE=

# Seconds a free user must view the create-gate sponsor (30 default). Set 0 in dev to skip.
VITE_CREATION_AD_SECONDS=30
# Set 1 in .env.local to simulate Pro (bypasses sponsor on create)
VITE_DEV_PREMIUM=

# --- AdRoll retargeting pixel (optional) ---
# From the AdRoll dashboard -> Settings -> Pixel. Both required to activate.
VITE_ADROLL_ADV_ID=
VITE_ADROLL_PIX_ID=

# --- Marketing / download buttons (point to GitHub Releases / store URLs once shipped) ---
VITE_DOWNLOAD_WIN=
VITE_DOWNLOAD_MAC=
VITE_DOWNLOAD_LINUX=
VITE_DOWNLOAD_IOS=
VITE_DOWNLOAD_ANDROID=

# --- Standalone marketing site (used by `npm run build:site`) ---
VITE_SITE_BASE=/
VITE_CONTACT_EMAIL=

# --- Social share / OAuth (optional) ---
# Google + Facebook social login is configured in the Supabase Dashboard
# (Auth -> Providers). A Facebook App ID here unlocks the Messenger Send Dialog.
VITE_FACEBOOK_APP_ID=

# ============================================================================
#  SERVER-SIDE ONLY (never prefixed VITE_ — these must NOT reach the browser)
# ============================================================================

# --- scripts/youtube-uploader.ts — publishes combined masters to OUR channel,
#     archives the master to the external drive, and purges transient uploads ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
# REQUIRED for the uploader: absolute path on the external drive where FINAL
# combined masters are archived. The worker FAILS LOUDLY (and never purges raw
# uploads) if this drive is missing — YouTube must never be the only copy.
# Point this at cold storage later without code changes.
ARCHIVE_DIR=E:\KillCamMasters
# Optional overrides for the worker's local tools.
FFMPEG_PATH=
YT_DLP_PATH=

# --- scripts/send-announcement.ts (mass email) ---
GMAIL_USER=killcam.app@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
ANNOUNCEMENT_SUBJECT=KillCam Announcement
