# --- Required for app to load ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Backend selection ---
# VITE_MOCK_BACKEND=1  in-memory mock (local UI work; nothing persists).
# VITE_REAL_BACKEND=1  the Express API under /api (production + real-device tests).
# Set exactly one, or neither to use the hosted Supabase project.
VITE_MOCK_BACKEND=
VITE_REAL_BACKEND=

# --- API origin (MOBILE BUILDS ONLY) ---
# Where the frontend sends its /api calls.
#   • WEB (tko.cam): leave UNSET. The app and API share an origin, so the
#     default relative '/api' is correct.
#   • MOBILE (Capacitor APK): REQUIRED. The WebView serves the bundle from
#     https://localhost, so a relative '/api' resolves to https://localhost/api
#     and the app can never reach the server. Set the absolute API origin:
#         VITE_API_BASE=https://tko.cam
#     (a trailing '/api' is optional — it is added if missing).
# _mobilebuild_real.bat sets this for you. The server must also allow the app's
# origin in CORS; see server/app.ts STATIC_ALLOWED_ORIGINS / APP_ORIGINS.
VITE_API_BASE=

# --- Deploy base path ---
# Controls the app's sub-path. Default (unset) = '/'.
#   • MOBILE (Capacitor / _mobilebuild.bat): leave UNSET → app serves from '/'.
#   • HOSTED WEB (tko.cam): set to /app/ so the app lives under tko.cam/app and
#     the marketing site (dist-site, base '/') owns the root. The Dockerfiles
#     already bake VITE_BASE_PATH=/app/ into the container build, so you only
#     need this locally to preview the /app layout.
# The router basename is derived from this via import.meta.env.BASE_URL.
VITE_BASE_PATH=

# --- Connect YouTube (client-side OAuth, no backend secret) ---
# Google OAuth *client id* for the Identity Services token client used by
# src/lib/youtubeConnect.ts. PUBLIC by design — the browser-only token flow
# never uses the client secret. Unset = "Connect YouTube" falls back to the
# manual channel-handle / paste-links path.
# The production value is baked into the Dockerfile build stage (ARG/ENV), since
# .gcloudignore strips .env.local from the Cloud Build upload.
VITE_YT_CLIENT_ID=
# Optional YouTube Data API key for richer library reads. Not required.
VITE_YT_API_KEY=

# --- AdSense (optional, leave empty to disable) ---
# Get a client ID from https://www.google.com/adsense/
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_RANKINGS_HERO=
VITE_ADSENSE_RANKINGS_BETWEEN=
VITE_ADSENSE_STAT_CHECK_HERO=
VITE_ADSENSE_STAT_CHECK_BETWEEN=
VITE_ADSENSE_SCREENSHOTS_SUBMIT=
VITE_ADSENSE_REEL_PREROLL=
# Creation gate: full-width ad before a free user can submit a new reel.
VITE_ADSENSE_CREATE_GATE=
# Future: before MP3/MP4 export without Pro.
VITE_ADSENSE_EXPORT_GATE=

# Seconds a free user must view the create-gate sponsor (30 default). Set 0 in dev to skip.
VITE_CREATION_AD_SECONDS=30
# Set 1 in .env.local to simulate Pro (bypasses sponsor on create)
VITE_DEV_PREMIUM=

# --- Marketing / download buttons (point to GitHub Releases / store URLs once shipped) ---
VITE_DOWNLOAD_WIN=
VITE_DOWNLOAD_MAC=
VITE_DOWNLOAD_LINUX=
VITE_DOWNLOAD_IOS=
VITE_DOWNLOAD_ANDROID=

# --- Standalone marketing site (used by `npm run build:site`) ---
# Sub-path if hosted under a folder (e.g. /reelone/). Default '/'.
VITE_SITE_BASE=/
# Absolute URL of the deployed app. When set, marketing CTAs deep-link there.
# Example: VITE_APP_URL=https://gio300.github.io/StrikerClips
VITE_APP_URL=
# Optional one-click contact button on the marketing site.
VITE_CONTACT_EMAIL=

# --- Social share / OAuth (optional) ---
# Google + Facebook social login is configured in Supabase Dashboard
# (Auth -> Providers). The frontend just calls signInWithOAuth.
#
# A Facebook App ID here unlocks the proper Messenger Send Dialog in
# share buttons (works on desktop + mobile). Without it we fall back to
# the fb-messenger:// deep link, which only works if Messenger is installed.
VITE_FACEBOOK_APP_ID=

# --- For scripts/send-announcement.ts (mass email) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GMAIL_USER=shinobivillage@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
ANNOUNCEMENT_SUBJECT=ReelOne Announcement

# --- Physical Forge commerce (server-only unless prefixed VITE_) ---
# Keep simulate mode for local QA. Live providers remain blocked until BOTH
# MERCH_MODE=live and the provider-specific allow flag are set to 1.
MERCH_MODE=simulate
MERCH_PAYOUT_HOLD_DAYS=14
MERCH_ALLOW_STRIPE_CHECKOUT=0
MERCH_ALLOW_SHOPIFY_WRITES=0
MERCH_ALLOW_PRINTFUL_DRAFTS=0
MERCH_ALLOW_STRIPE_TRANSFERS=0
MERCH_ALLOW_FULFILLMENT_CONFIRM=0
MERCH_ALLOW_AI_DESIGN=0

# Stripe Elements is embedded in TKO; this publishable key is safe in the
# browser. The secret key and webhook secret must stay server-side.
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# TKO calls the Shopify CLI app's authenticated server-to-server bridge.
# Example URL after the app is hosted: https://shopify-app.example/api/tko-bridge
SHOPIFY_BRIDGE_URL=
TKO_SHOPIFY_BRIDGE_SECRET=
TKO_SHOPIFY_TEST_ORDERS=1

# Printful remains a draft-only adapter until an operator explicitly confirms
# the product/variant mapping and proof.
PRINTFUL_ACCESS_TOKEN=
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_SECRET=
PRINTFUL_VARIANT_BLACK_S=
PRINTFUL_VARIANT_BLACK_M=
PRINTFUL_VARIANT_BLACK_L=
PRINTFUL_VARIANT_BLACK_XL=
PRINTFUL_VARIANT_BLACK_2XL=
