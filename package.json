{
  "name": "tko-cam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0 --port 5889",
    "build": "vite build",
    "preview": "vite preview",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "vite build --config vite.site.config.ts && node -e \"require('fs').renameSync('dist-site/index.site.html','dist-site/index.html')\"",
    "preview:site": "vite preview --config vite.site.config.ts --outDir dist-site",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "send-announcement": "tsx scripts/send-announcement.ts",
    "vapid:keys": "tsx scripts/generate-vapid-keys.ts",
    "youtube-uploader": "tsx scripts/youtube-uploader.ts",
    "render-worker": "tsx server/renderWorker.run.ts",
    "media-worker": "tsx server/mediaAnalysisWorker.run.ts --once",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsx server/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1106.0",
